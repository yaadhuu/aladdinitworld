# Copy to .env.local and fill in. Names only here: never commit real values.

# Sanity project (public by design: they identify the project, they do not unlock it)
NEXT_PUBLIC_SANITY_PROJECT_ID=
# production or staging
NEXT_PUBLIC_SANITY_DATASET=production

# Where the separate Studio lives, for example https://admin.aladdinitworld.com or https://<name>.sanity.studio.
# /admin on the site forwards there. Read at build time.
STUDIO_URL=

# Server only, read-only (Viewer). Needed for "Preview on website" in the Studio, and if the dataset is ever made private.
SANITY_API_READ_TOKEN=

# AI shop assistant (server only)
ANTHROPIC_API_KEY=

# Set to 1 only when the site sits behind your own proxy that overwrites x-forwarded-for
TRUSTED_PROXY=
